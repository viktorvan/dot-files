# Let Zim Framework initialize completions instead of the global zshrc.
skip_global_compinit=1
export EDITOR=nvim
export VISUAL=nvim

if [[ "$OSTYPE" == linux* ]]; then
  # Executables needed by non-interactive SSH sessions and Herdr
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  . "$HOME/.cargo/env"
fi

export OPENCODE_DISABLE_FREE_MODELS=1

# Source secret environment variables if the file exists
if [[ -r ~/secrets/set_secret_env_vars.sh ]]; then
  source ~/secrets/set_secret_env_vars.sh
fi
