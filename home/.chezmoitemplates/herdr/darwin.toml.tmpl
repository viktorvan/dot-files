onboarding = false

[theme]
name = "catppuccin-latte"
auto_switch = false

[ui]
tab_bar_position = "top"
prompt_new_tab_name = false
mouse_capture = true
pane_gaps = false
pane_outer_borders = false
tab_bar_right = [{ type = "hostname" }]
confirm_close = true

[keys]
prefix = "ctrl+a"
split_vertical = "prefix+%"
split_horizontal = 'prefix+"'
detach = "prefix+d"
rename_tab = "prefix+comma"
focus_pane_left = "prefix+h"
focus_pane_down = "prefix+j"
focus_pane_up = "prefix+k"
focus_pane_right = "prefix+l"
navigate_pane_left = "alt+m"
navigate_pane_down = "alt+n"
navigate_pane_up = "alt+e"
navigate_pane_right = "alt+i"

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin/lazygit{{ else }}/usr/local/bin/lazygit{{ end }}"
description = "run lazygit"
width = "95%"
height = "95%"
{{ range $binding := list (dict "key" "m" "direction" "left") (dict "key" "n" "direction" "down") (dict "key" "e" "direction" "up") (dict "key" "i" "direction" "right") -}}
[[keys.command]]
key = "alt+{{ $binding.key }}"
type = "shell"
command = '"$HOME/.config/herdr/navigate.sh" {{ $binding.direction }}'
description = "navigate {{ $binding.direction }} through editor splits and Herdr panes"

{{ end -}}
[[keys.command]]
key = "prefix+alt+d"
type = "plugin_action"
command = "worktrunk.remove"
description = "Worktree: remove"

[[keys.command]]
key = "prefix+alt+p"
type = "popup"
command = "wt switch --prs --no-cd -x herdr -- worktree open --path . --focus"
description = "Open GitHub PR as Herdr worktree"
width = "90%"
height = "90%"
