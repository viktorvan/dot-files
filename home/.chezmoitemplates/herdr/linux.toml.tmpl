onboarding = false

[ui]
tab_bar_position = "top"
prompt_new_tab_name = false
mouse_capture = true
pane_gaps = false
pane_outer_borders = false
tab_bar_right = [{ type = "hostname" }]
confirm_close = true

[keys]
new_worktree = ""

[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open"
description = "Worktree: switch / create through Worktrunk"

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/lazygit"
description = "run lazygit"
width = "95%"
height = "95%"
[[keys.command]]
key = "prefix+alt+b"
type = "popup"
command = "/usr/bin/btop"
description = "run btop"
width = "95%"
height = "95%"
{{ range $binding := list (dict "key" "m" "direction" "left") (dict "key" "n" "direction" "down") (dict "key" "e" "direction" "up") (dict "key" "i" "direction" "right") -}}
[[keys.command]]
key = "alt+{{ $binding.key }}"
type = "shell"
command = '"$HOME/.config/herdr/navigate.sh" {{ $binding.direction }}'
description = "navigate {{ $binding.direction }} through editor splits and Herdr panes"

{{ end -}}
[[keys.command]]
key = "prefix+alt+d"
type = "plugin_action"
command = "worktrunk.remove"
description = "Worktree: remove"

[[keys.command]]
key = "prefix+alt+p"
type = "popup"
command = "gh pr list --limit 100 --json number,title,headRefName --jq '.[] | \"\\(.number)\\t\\(.title)\\t\\(.headRefName)\"' | fzf --delimiter='\\t' --with-nth=1,2,3 | cut -f1 | xargs -r -I{} wt switch 'pr:{}' --no-cd -x herdr -- worktree open --path . --focus"
description = "Open GitHub PR as Herdr worktree"
width = "90%"
height = "90%"

[[keys.command]]
key = "prefix+f"
type = "plugin_action"
command = "hotchpotch.herdr-tiny-fingers.open"
description = "Copy text with hints"
