{{ if eq .chezmoi.os "darwin" -}}
onboarding = false

[theme]
name = "catppuccin-latte"
auto_switch = false

[ui]
tab_bar_position = "top"
prompt_new_tab_name = false
mouse_capture = true
pane_gaps = false
pane_outer_borders = false
tab_bar_right = [{ type = "hostname" }]

[keys]
prefix = "ctrl+a"
split_vertical = "prefix+%"
split_horizontal = 'prefix+"'
detach = "prefix+d"
rename_tab = "prefix+comma"
focus_pane_left = ["alt+m", "prefix+h"]
focus_pane_down = ["alt+n", "prefix+j"]
focus_pane_up = ["alt+e", "prefix+k"]
focus_pane_right = ["alt+i", "prefix+l"]
navigate_pane_left = "alt+m"
navigate_pane_down = "alt+n"
navigate_pane_up = "alt+e"
navigate_pane_right = "alt+i"

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin/lazygit{{ else }}/usr/local/bin/lazygit{{ end }}"
description = "run lazygit"
width = "95%"
height = "95%"
{{ else -}}
[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/lazygit"
description = "run lazygit"
width = "95%"
height = "95%"
[[keys.command]]
key = "prefix+alt+b"
type = "popup"
command = "/usr/bin/btop"
description = "run btop"
width = "95%"
height = "95%"
{{ end -}}
