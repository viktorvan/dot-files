{
	"title": "Remap tab to tab+hyper",
	"rules": [
		{
			"description": "Change tab to hyper when used as modifier, tab when used alone",
			"manipulators": [
				{
					"from": {
						"key_code": "tab"
					},
					"to": [
						{
							"key_code": "left_shift",
							"modifiers": [
								"left_command",
								"left_control",
								"left_option"
							]
						}
					],
					"to_if_alone": [
						{
							"key_code": "caps_lock"
						}
					],
					"type": "basic"
				}
			]
		}
	]
}