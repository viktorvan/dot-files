{
	"title": "Disable macos shortcuts for sysdiagnose",
	"rules": [
		{
			"description": "Disable Command-Shift-Option-Control-Period (.)",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "period",
						"modifiers": {
							"mandatory": [
								"command",
								"shift",
								"option",
								"control"
							]
						}
					}
				}
			]
		},
		{
			"description": "Disable Command-Shift-Option-Control-Comma (,)",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "comma",
						"modifiers": {
							"mandatory": [
								"command",
								"shift",
								"option",
								"control"
							]
						}
					}
				}
			]
		}
	]
}