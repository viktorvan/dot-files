{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "build",
  "permissions": [
    {"action": "shell", "resource": "dotnet test *", "effect": "deny"},
    {"action": "shell", "resource": "just local dotnet-test Api.slnx", "effect": "deny"},
    {"action": "shell", "resource": "just local dotnet-test \"Api.slnx\"", "effect": "deny"},
    {"action": "shell", "resource": "just local dotnet-test Api.slnx *", "effect": "deny"},
    {"action": "shell", "resource": "just local dotnet-test \"Api.slnx\" *", "effect": "deny"},
    {"action": "shell", "resource": "just all-logistics-tests-sln", "effect": "deny"},
    {"action": "shell", "resource": "just all-patient-tests-sln", "effect": "deny"},
    {"action": "shell", "resource": "dotnet build *", "effect": "deny"},
    {"action": "shell", "resource": "docker *", "effect": "allow"},
    {"action": "shell", "resource": "docker-compose *", "effect": "deny"},
    {"action": "shell", "resource": "git *", "effect": "ask"},
    {"action": "shell", "resource": "rm *", "effect": "ask"},
    {"action": "shell", "resource": "git checkout *", "effect": "allow"},
    {"action": "shell", "resource": "git branch -vv", "effect": "allow"},
    {"action": "shell", "resource": "git remote -v", "effect": "allow"},
    {"action": "shell", "resource": "git status", "effect": "allow"},
    {"action": "shell", "resource": "git status *", "effect": "allow"},
    {"action": "shell", "resource": "git diff", "effect": "allow"},
    {"action": "shell", "resource": "git diff *", "effect": "allow"},
    {"action": "shell", "resource": "git log", "effect": "allow"},
    {"action": "shell", "resource": "git log *", "effect": "allow"},
    {"action": "shell", "resource": "git show", "effect": "allow"},
    {"action": "shell", "resource": "git show *", "effect": "allow"},
    {"action": "shell", "resource": "git describe", "effect": "allow"},
    {"action": "shell", "resource": "git describe *", "effect": "allow"},
    {"action": "shell", "resource": "git reflog", "effect": "allow"},
    {"action": "shell", "resource": "git reflog *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-files", "effect": "allow"},
    {"action": "shell", "resource": "git ls-files *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-tree", "effect": "allow"},
    {"action": "shell", "resource": "git ls-tree *", "effect": "allow"},
    {"action": "shell", "resource": "git cat-file", "effect": "allow"},
    {"action": "shell", "resource": "git cat-file *", "effect": "allow"},
    {"action": "shell", "resource": "git rev-parse", "effect": "allow"},
    {"action": "shell", "resource": "git rev-parse *", "effect": "allow"},
    {"action": "shell", "resource": "git name-rev", "effect": "allow"},
    {"action": "shell", "resource": "git name-rev *", "effect": "allow"},
    {"action": "shell", "resource": "git for-each-ref", "effect": "allow"},
    {"action": "shell", "resource": "git for-each-ref *", "effect": "allow"},
    {"action": "shell", "resource": "git grep", "effect": "allow"},
    {"action": "shell", "resource": "git grep *", "effect": "allow"},
    {"action": "shell", "resource": "git config --get*", "effect": "allow"},
    {"action": "shell", "resource": "git help", "effect": "allow"},
    {"action": "shell", "resource": "git help *", "effect": "allow"},
    {"action": "shell", "resource": "git branch --show-current", "effect": "allow"},
    {"action": "shell", "resource": "git add *", "effect": "allow"},
    {"action": "shell", "resource": "git commit *", "effect": "allow"},
    {"action": "shell", "resource": "git stash list *", "effect": "allow"},
    {"action": "shell", "resource": "git stash show *", "effect": "allow"},
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "scripts/dotnet_test.sh", "effect": "deny"},
    {"action": "read", "resource": "scripts/dotnet_build.sh", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "external_directory", "resource": "/tmp/**", "effect": "allow"}
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "linear": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote",
          "https://mcp.linear.app/mcp",
          "3334",
          "--host",
          "127.0.0.1",
          "--auth-timeout",
          "300",
          "--header",
          "Authorization: Bearer ${LINEAR_API_KEY}"
        ],
        "timeout": {
          "catalog": 300000,
          "execution": 300000
        }
      },
      "elastic": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "ES_URL",
          "-e",
          "ES_API_KEY",
          "docker.elastic.co/mcp/elasticsearch",
          "stdio"
        ],
        "environment": {
          "ES_URL": "https://app-logs-elk-dev.es.westus2.azure.elastic-cloud.com:9243"
        }
      }
    }
  }
}
