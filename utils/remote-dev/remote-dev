#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: remote-dev [operation] [script args]

Run without an operation to choose one with fzf.

Operations:
  status             List remote-dev servers and their status
  up                 Start existing server or create one from the latest snapshot
  stop-and-snapshot  Gracefully stop the server and create a snapshot
  snapshots          List remote-dev snapshots
  delete-snapshots   Select and delete remote-dev snapshots
  delete             Delete the stopped server after snapshot safety checks
EOF
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$command_name" >&2
    exit 1
  fi
}

resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd
}

pick_operation() {
  require_command fzf

  local selection
  selection="$(printf '%-18s %s\n' \
    'status' 'List remote-dev servers and their status' \
    'up' 'Start or create the server from the latest snapshot' \
    'stop-and-snapshot' 'Stop the server and create a snapshot' \
    'snapshots' 'List available snapshots' \
    'delete-snapshots' 'Select and delete remote-dev snapshots' \
    'delete' 'Delete stopped server after safety checks' \
    | fzf --prompt 'remote-dev> ' --header 'Select operation')"

  if [[ -z "$selection" ]]; then
    printf 'No operation selected.\n' >&2
    exit 1
  fi

  printf '%s\n' "${selection%% *}"
}

script_dir="$(resolve_script_dir)"

if [[ $# -eq 0 ]]; then
  operation="$(pick_operation)"
else
  operation="$1"
  shift
fi

case "$operation" in
  status|servers|ls)
    exec "$script_dir/remote-dev-status.sh" "$@"
    ;;
  up|start)
    exec "$script_dir/remote-dev-up.sh" "$@"
    ;;
  stop-and-snapshot|snapshot|stop)
    exec "$script_dir/remote-dev-stop-and-snapshot.sh" "$@"
    ;;
  snapshots|list)
    exec "$script_dir/remote-dev-snapshots.sh" "$@"
    ;;
  delete-snapshots|prune-snapshots)
    exec "$script_dir/remote-dev-delete-snapshots.sh" "$@"
    ;;
  delete|rm)
    exec "$script_dir/remote-dev-delete.sh" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
