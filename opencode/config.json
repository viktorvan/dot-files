{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "captain",
  "permission": {
    "bash": {
      "dotnet test *": "ask",
      "just local dotnet-test Api.slnx": "deny",
      "just local dotnet-test \"Api.slnx\"": "deny",
      "just local dotnet-test Api.slnx *": "deny",
      "just local dotnet-test \"Api.slnx\" *": "deny",
      "just all-logistics-tests-sln": "deny",
      "just all-patient-tests-sln": "deny",
      "dotnet build *": "deny",
      "docker *": "allow",
      "docker-compose *": "deny",
      "git *": "ask",
      "rm *": "ask",
      "git checkout *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git reflog": "allow",
      "git reflog *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree": "allow",
      "git ls-tree *": "allow",
      "git cat-file": "allow",
      "git cat-file *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git name-rev": "allow",
      "git name-rev *": "allow",
      "git for-each-ref": "allow",
      "git for-each-ref *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "git config --get*": "allow",
      "git help": "allow",
      "git help *": "allow",
      "git branch --show-current": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git stash *": "allow"
    },
    "read": {
     "*": "allow",
      "scripts/dotnet_test.sh": "deny",
      "scripts/dotnet_build.sh": "deny",
    },
    "external_directory": "ask"

  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    "sagefs": {
      "type": "remote",
      "url": "http://localhost:37749",
      "enabled": false
    },
    "elastic": {
      "enabled": true,
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "-e",
        "ES_API_KEY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "environment": {
        "ES_URL": "https://app-logs-elk-dev.es.westus2.azure.elastic-cloud.com:9243"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": false
    }
  },
  "plugin": [
    "file:///Users/viktor/developer/oss/opencode-morph-fast-apply",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "instructions": [
    "/Users/viktor/developer/oss/opencode-morph-fast-apply/MORPH_INSTRUCTIONS.md"
  ]
}
